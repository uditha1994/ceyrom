{
  "name": "ceyrom",
  "version": "0.1.0",
  "private": true,
  "description": "Ceyrom \u2014 a Sri Lankan carrom game for the browser",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-server/server.mjs --packages=external",
    "build:single": "vite build --mode single",
    "start": "node dist-server/server.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "i18next": "^26.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.1.12",
    "ws": "^8.22.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
